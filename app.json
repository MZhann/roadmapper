{
  "expo": {
    "name": "Milo",
    "slug": "milo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/milo-icon.png",
    "scheme": "milo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.milo.roadmapper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3346D3",
        "foregroundImage": "./assets/images/milo-icon.png"
      },
      "package": "app.milo.roadmapper"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/milo-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F5",
          "image": "./assets/images/milo-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0F1113"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Milo to add photos you choose to your private journal.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "216f5ee1-bb99-40a6-89e2-a6bcf795f6f4"
      }
    },
    "owner": "zhanbo04"
  }
}
